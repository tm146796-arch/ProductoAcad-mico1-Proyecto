<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TituloPantalla">
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextoNormal">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextoResultado">
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CampoEntrada" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
    </style>

    <style name="BotonPrincipal" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
